{
  "name": "uknow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --watch scripts --watch sql --ignore \"uploads/**\" --ignore \"private-uploads/**\" --ext js,mjs,cjs,json,sql src/index.js",
    "migrate": "node scripts/migrate.js",
    "provision:admin": "node scripts/provision-admin.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
