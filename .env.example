# Atelier U-Know Multi-Mart — Backend Environment Configuration Example
# Port 4000 is reserved by TiDB Cloud, so the API listens on 4100.
BACKEND_PORT=4100
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Courier integrations are managed in Admin -> Couriers (stored in the database).
# Trax is pre-configured there; paste its API key in the admin panel instead of
# putting courier credentials in this file.

# MySQL / TiDB Configuration (keep real credentials in .env, never commit it).
# TiDB Cloud: DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com, DB_PORT=4000.
# DB_SSL_CA is the public CA bundle used to verify the TLS certificate.
# CA download: https://letsencrypt.org/certs/isrgrootx1.pem
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uknow_store
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# Security & Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Email verification for website-created accounts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Provider authentication (client IDs are public; Facebook secret stays backend-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Use the public HTTPS backend origin in production.
API_PUBLIC_URL=http://localhost:4100

# Authoritative Store & Logistics Defaults
DEFAULT_STANDARD_SHIPPING_FEE=300
DEFAULT_FREE_SHIPPING_THRESHOLD=3500
DEFAULT_URGENT_SHIPPING_FEE=500
DEFAULT_ADVANCE_PAYMENT_THRESHOLD=2000
DEFAULT_ADVANCE_PAYMENT_PERCENT=20
PRESENCE_HIDDEN_EXPIRY_MINUTES=15
LOG_LEVEL=warn

# In development, when SMTP is not configured, signup returns a one-time
# verification link in the response for local testing. Production always requires SMTP.
